# Server
PORT=3000
HOST=0.0.0.0
NODE_ENV=development

# Database
DATABASE_URL=postgresql://postgres:devpass@localhost:5450/webhooks

# Redis
REDIS_URL=redis://localhost:6379
# Redis password (required in production — used by docker-compose.prod.yml)
REDIS_PASSWORD=

# Tenant Management
SELF_REGISTRATION_ENABLED=true

# Delivery
DELIVERY_CONCURRENCY=10
DELIVERY_DEFAULT_TIMEOUT_MS=10000
DELIVERY_MAX_RETRIES=5
DELIVERY_BACKOFF_BASE_MS=1000

# Replay
REPLAY_BATCH_SIZE=100

# Archival
EVENT_ARCHIVE_DAYS=90

# Payload limits
MAX_PAYLOAD_BYTES=1048576

# Signature timestamp tolerance (ms). Default 300000 (5 min). Set 0 to disable.
SIGNATURE_TOLERANCE_MS=300000

# Logging
LOG_LEVEL=info

# Encryption — 64 hex chars (32 bytes) for AES-256-GCM encryption of signing secrets
# Required if any source uses signing secrets. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SIGNING_SECRET_KEY=

# Ecosystem (optional — feature-flagged via destinations table)
NOTIFICATION_HUB_URL=
NOTIFICATION_HUB_API_KEY=
WORKFLOW_ENGINE_URL=
WORKFLOW_ENGINE_SECRET=
