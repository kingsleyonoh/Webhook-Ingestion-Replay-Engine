# Server
PORT=3000
HOST=0.0.0.0
NODE_ENV=development

# Database
DATABASE_URL=postgresql://postgres:devpass@localhost:5450/webhooks

# Redis
REDIS_URL=redis://localhost:6379

# Tenant Management
SELF_REGISTRATION_ENABLED=true

# Delivery
DELIVERY_CONCURRENCY=10
DELIVERY_DEFAULT_TIMEOUT_MS=10000
DELIVERY_MAX_RETRIES=5
DELIVERY_BACKOFF_BASE_MS=1000

# Replay
REPLAY_BATCH_SIZE=100

# Archival
EVENT_ARCHIVE_DAYS=90

# Payload limits
MAX_PAYLOAD_BYTES=1048576

# Logging
LOG_LEVEL=info

# Ecosystem (optional — feature-flagged via destinations table)
NOTIFICATION_HUB_URL=
NOTIFICATION_HUB_API_KEY=
WORKFLOW_ENGINE_URL=
WORKFLOW_ENGINE_SECRET=
